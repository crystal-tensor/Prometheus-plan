  "candidate_contract": {
    "candidate": "the same correction-bit online decoder after quantizing each decomposed detector-error probability by its log-likelihood weight",
    "changed": "only the probability-derived base and implied weight values are represented on an 8-bit fixed-point grid",
    "fixed_point_scale": 16,
    "quantization": "q=max(1, round(16*log((1-p)/p))); p_quantized=1/(1+exp(q/16)); require q<=255",
    "reference_full_block": "unquantized PyMatching 2.4.0 two-pass correlated decode over the complete 1,000-round detector error model",
    "reference_online": "unquantized public correction-bit fault-vector decoder under the frozen 3d window, d commit, and 2d look-ahead contract",
    "unchanged": [
      "distance-6 X/Z circuits, 71 active qubits, physical noise, and 1,000-round horizon",
      "3d=18 windows, d=6 commits, and 2d=12 look-ahead",
      "detector and observable correction-bit output maps",
      "decomposed correlation groups and all graph endpoints",
      "two-pass correlated matching, arrival order, propagation, frame, and residual rules",
      "single-stream execution with no cross-shot batching"
    ],
    "weight_bits": 8
  },
