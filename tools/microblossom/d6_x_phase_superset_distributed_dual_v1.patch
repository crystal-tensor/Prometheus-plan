+  def simUpdateWeight(edgeIndex: Int, weight: Int): Unit = {
+    require(!config.hardCodeWeights, "dynamic weight update requires hardCodeWeights=false")
+    require(edgeIndex >= 0 && edgeIndex < config.edgeNum, "edge index out of range")
+    require(weight >= 0 && BigInt(weight) < (BigInt(1) << config.weightBits), "weight out of range")
+    io.message.valid #= true
+    io.message.instruction #= ioConfig.instructionSpec.generateLoadWeightsExternal()
+    io.message.weightUpdateEdgeIndex #= edgeIndex
+    io.message.weightUpdateWeight #= weight
+    io.message.weightUpdateIsRuleSelector #= false
+    io.message.phaseSelectValid #= false
+    io.message.phaseId #= 0
+    clockDomain.waitSampling()
+    io.message.valid #= false
+    for (idx <- 0 until config.readLatency - 1) { clockDomain.waitSampling() }
+    sleep(1)
+  }
+
+  def simApplyResidentRuleSelector(sourceEdgeIndex: Int): Unit = {
+    require(!config.hardCodeWeights, "resident rule selector requires hardCodeWeights=false")
+    require(
+      config.residentWeightRules.nonEmpty || config.phaseBanks.exists(_.residentWeightRules.nonEmpty),
+      "resident rule selector table is empty"
+    )
+    require(sourceEdgeIndex >= 0 && sourceEdgeIndex < config.edgeNum, "source edge index out of range")
+    io.message.valid #= true
+    io.message.instruction #= ioConfig.instructionSpec.generateLoadWeightsExternal()
+    io.message.weightUpdateEdgeIndex #= sourceEdgeIndex
+    io.message.weightUpdateWeight #= 0
+    io.message.weightUpdateIsRuleSelector #= true
+    io.message.phaseSelectValid #= false
+    io.message.phaseId #= 0
+    clockDomain.waitSampling()
+    io.message.valid #= false
+    for (idx <- 0 until config.readLatency - 1) { clockDomain.waitSampling() }
+    sleep(1)
+  }
+
+  def simSelectPhase(phaseId: Int): Unit = {
+    require(config.phaseBanks.nonEmpty, "phase banks are not configured")
+    require(phaseId >= 0 && phaseId < config.phaseBanks.length, "phase id out of range")
+    io.message.valid #= true
+    io.message.instruction #= ioConfig.instructionSpec.generateReset()
+    io.message.weightUpdateEdgeIndex #= 0
+    io.message.weightUpdateWeight #= 0
+    io.message.weightUpdateIsRuleSelector #= false
+    io.message.phaseSelectValid #= true
+    io.message.phaseId #= phaseId
+    clockDomain.waitSampling()
+    io.message.valid #= false
+    io.message.phaseSelectValid #= false
+    for (idx <- 0 until config.readLatency - 1) { clockDomain.waitSampling() }
+    sleep(1)
+  }
