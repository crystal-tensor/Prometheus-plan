+use fusion_blossom::mwpm_solver::PrimalDualSolver;
+use fusion_blossom::primal_module::SubGraphBuilder;
+use fusion_blossom::util::SyndromePattern;
+use micro_blossom::mwpm_solver::SolverEmbeddedComb;
+use micro_blossom::resources::MicroBlossomSingle;
+use serde::{Deserialize, Serialize};
+use serde_json::json;
+use std::collections::{BTreeMap, BTreeSet};
+use std::env;
+use std::fs;
+
+#[derive(Deserialize)]
+struct Input {
+    phase_banks: Vec<PhaseBank>,
+    phase_graphs: Vec<PhaseGraph>,
+    cases: Vec<Case>,
+    evidence_id: String,
+}
+
+#[derive(Deserialize)]
+struct PhaseBank {
+    name: String,
+    resident_weight_rules: Vec<ResidentRule>,
+    edge_fault_ids: Vec<Vec<usize>>,
+    fault_id_count: usize,
+}
+
+#[derive(Deserialize)]
+struct ResidentRule {
+    target: usize,
+    rules: Vec<(usize, isize)>,
+}
+
+#[derive(Deserialize)]
+struct PhaseGraph {
+    name: String,
+    graph: MicroBlossomSingle,
+    local_to_superset_edge: Vec<usize>,
+}
+
+#[derive(Deserialize)]
+struct Case {
+    phase: String,
+    phase_index: usize,
+    boundary: String,
+    shot: usize,
+    window: usize,
+    defect_vertices: Vec<usize>,
+    selector_edges: Vec<usize>,
+    expected_correction_hex: String,
+    fault_id_count: usize,
+}
+
+#[derive(Serialize)]
+struct Row {
+    phase: String,
+    boundary: String,
+    shot: usize,
+    window: usize,
+    defects: usize,
+    selectors: usize,
+    iterations: usize,
+    actual_subgraph_superset_edges: Vec<usize>,
+    syndrome_valid: bool,
+    correction_hex: String,
+    correction_equal: bool,
+}
+
+fn bits_hex(bits: &[bool]) -> String {
+    let mut value = String::new();
+    for nibble in (0..bits.len().div_ceil(4)).rev() {
+        let mut digit = 0u8;
+        for offset in 0..4 {
+            let index = nibble * 4 + offset;
+            if index < bits.len() && bits[index] {
+                digit |= 1 << offset;
+            }
+        }
+        value.push(char::from_digit(digit as u32, 16).unwrap());
+    }
+    let trimmed = value.trim_start_matches('0');
+    if trimmed.is_empty() {
+        "0".to_string()
+    } else {
+        trimmed.to_string()
+    }
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    assert_eq!(args.len(), 3, "usage: <input.json> <output.json>");
+    let input: Input = serde_json::from_slice(&fs::read(&args[1]).unwrap()).unwrap();
+    let mut rows = Vec::new();
+    for (case_index, case) in input.cases.into_iter().enumerate() {
+        let phase = &input.phase_graphs[case.phase_index];
+        let bank = &input.phase_banks[case.phase_index];
+        assert_eq!(phase.name, case.phase);
+        assert_eq!(bank.name, case.phase);
+        assert_eq!(bank.fault_id_count, case.fault_id_count);
+        let graph = phase.graph.clone();
+        let superset_to_local: BTreeMap<_, _> = phase
+            .local_to_superset_edge
+            .iter()
+            .enumerate()
+            .map(|(local, &superset)| (superset, local))
+            .collect();
+        let selectors: BTreeSet<_> = case.selector_edges.iter().copied().collect();
+        let mut deferred_weights: BTreeMap<usize, isize> = graph
+            .weighted_edges
+            .iter()
+            .enumerate()
+            .map(|(edge, weighted)| (edge, weighted.w))
+            .collect();
+        for rule in &bank.resident_weight_rules {
+            let Some(&target_local) = superset_to_local.get(&rule.target) else {
+                continue;
+            };
+            for &(source, replacement) in &rule.rules {
+                if selectors.contains(&source) {
+                    let weight = deferred_weights.get_mut(&target_local).unwrap();
+                    *weight = (*weight).min(replacement);
+                }
+            }
+        }
+        println!(
+            "COMB_CASE_START index={} phase={} boundary={} defects={} selectors={}",
+            case_index,
+            case.phase,
+            case.boundary,
+            case.defect_vertices.len(),
+            case.selector_edges.len()
+        );
+        let mut solver = SolverEmbeddedComb::new(
+            graph.clone(),
+            json!({
+                "max_iterations": 500000,
+                "iteration_progress": 10000,
+                "dual": {}
+            }),
+        );
+        for (edge, weight) in deferred_weights {
+            if weight != graph.weighted_edges[edge].w {
+                solver.dual_module.driver.driver.queue_edge_weight(edge, weight);
+            }
+        }
+        let syndrome = SyndromePattern::new_vertices(case.defect_vertices.clone());
+        solver.solve_visualizer(&syndrome, None);
+        let perfect_matching = solver.perfect_matching_visualizer(None);
+        let initializer = graph.get_initializer();
+        let mut builder = SubGraphBuilder::new(&initializer);
+        builder.load_perfect_matching(&perfect_matching);
+        let actual_local = builder.get_subgraph();
+        let expected_vertices: BTreeSet<_> = case.defect_vertices.iter().copied().collect();
+        let syndrome_valid = initializer.syndrome_of(&actual_local) == expected_vertices;
+        let actual_superset: Vec<_> = actual_local.iter().map(|&edge| phase.local_to_superset_edge[edge]).collect();
+        let mut correction = vec![false; bank.fault_id_count];
+        for &edge in &actual_superset {
+            for &fault in &bank.edge_fault_ids[edge] {
+                correction[fault] = !correction[fault];
+            }
+        }
+        let correction_hex = bits_hex(&correction);
+        let correction_equal = correction_hex == case.expected_correction_hex;
+        println!(
+            "COMB_CASE_DONE index={} phase={} boundary={} iterations={} syndrome_valid={} correction_equal={}",
+            case_index, case.phase, case.boundary, solver.last_iterations, syndrome_valid, correction_equal
+        );
+        rows.push(Row {
+            phase: case.phase,
+            boundary: case.boundary,
+            shot: case.shot,
+            window: case.window,
+            defects: case.defect_vertices.len(),
+            selectors: case.selector_edges.len(),
+            iterations: solver.last_iterations,
+            actual_subgraph_superset_edges: actual_superset,
+            syndrome_valid,
+            correction_hex,
+            correction_equal,
+        });
+    }
+    let all_syndromes_valid = rows.iter().all(|row| row.syndrome_valid);
+    let all_corrections_equal = rows.iter().all(|row| row.correction_equal);
+    let output = json!({
+        "schema": "d6_x_phase_primal_dual_comb_control_v1",
+        "input_evidence_id": input.evidence_id,
+        "cases": rows,
+        "summary": {
+            "cases": rows.len(),
+            "all_syndromes_valid": all_syndromes_valid,
+            "all_corrections_equal": all_corrections_equal,
+            "max_iterations": rows.iter().map(|row| row.iterations).max().unwrap_or(0),
+        }
+    });
+    fs::write(&args[2], serde_json::to_vec_pretty(&output).unwrap()).unwrap();
+    println!("{}", serde_json::to_string(&output["summary"]).unwrap());
+    assert!(all_syndromes_valid, "comb control syndrome mismatch");
+    assert!(all_corrections_equal, "comb control correction mismatch");
+}
